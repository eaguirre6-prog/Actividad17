@page "/estudiantes"
@using Microsoft.EntityFrameworkCore
@using Actividad17.Data
@using Actividad17.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Estudiantes</PageTitle>

<h3>Gestión de Estudiantes</h3>

<EditForm Model="@estudiante" OnValidSubmit="GuardarEstudiante" FormName="guardarEstudianteForm">
    <DataAnnotationsValidator />

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Nombre</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="estudiante.Nombre" />
            <ValidationMessage For="@(() => estudiante.Nombre)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Correo</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="estudiante.Correo" />
            <ValidationMessage For="@(() => estudiante.Correo)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Calificación</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="estudiante.Calificacion" />
            <ValidationMessage For="@(() => estudiante.Calificacion)" class="text-danger" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mb-4">
        @(estudiante.Id == 0 ? "Guardar" : "Actualizar")
    </button>
    @if (estudiante.Id != 0)
    {
        <button type="button" class="btn btn-secondary mb-4 ms-2" @onclick="CancelarEdicion">Cancelar</button>
    }
</EditForm>

@if (listaEstudiantes != null && listaEstudiantes.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Calificación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in listaEstudiantes)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.Correo</td>
                    <td>@item.Calificacion</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-warning me-2" @onclick="() => SeleccionarParaEditar(item)">
                            ✏️
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarEstudiante(item.Id)">
                            🗑️
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No hay estudiantes registrados.</p>
}

@code {
    private Estudiante estudiante { get; set; } = new();
    private List<Estudiante> listaEstudiantes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task CargarEstudiantes()
    {
        using var context = DbFactory.CreateDbContext();
        listaEstudiantes = await context.Estudiantes.ToListAsync();
    }

    private async Task GuardarEstudiante()
    {
        using var context = DbFactory.CreateDbContext();

        if (estudiante.Id == 0)
        {
            context.Estudiantes.Add(estudiante);
        }
        else
        {
            context.Estudiantes.Update(estudiante);
        }

        await context.SaveChangesAsync();
        estudiante = new Estudiante();
        await CargarEstudiantes();
    }

    private void SeleccionarParaEditar(Estudiante item)
    {
        estudiante = new Estudiante
        {
            Id = item.Id,
            Nombre = item.Nombre,
            Correo = item.Correo,
            Calificacion = item.Calificacion
        };
    }

    private void CancelarEdicion()
    {
        estudiante = new Estudiante();
    }

    private async Task EliminarEstudiante(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var est = await context.Estudiantes.FindAsync(id);
        if (est != null)
        {
            context.Estudiantes.Remove(est);
            await context.SaveChangesAsync();
            await CargarEstudiantes();
        }
    }
}